{
  "name": "dental-clinic-backend-local",
  "version": "1.0.0",
  "description": "Balane-Saspa Dental Clinic — local PostgreSQL testing (no Redis, no email)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "psql -U postgres -c \"CREATE DATABASE dental_clinic;\" && psql -U postgres -d dental_clinic -f schema.sql",
    "db:reset": "psql -U postgres -d dental_clinic -f schema.sql"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.3",
    "validator": "^13.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
